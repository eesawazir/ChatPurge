{
  "manifest_version": 3,
  "name": "ChatPurge",
  "version": "1.7.6",
  "minimum_chrome_version": "111",
  "description": "Adds checkboxes to the ChatGPT and Claude sidebars so you can bulk-delete chats.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Toggle chat selection (Alt+Shift+D)",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["sites/chatgpt.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["sites/claude.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["sites/claude-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
